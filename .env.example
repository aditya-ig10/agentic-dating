# Copy to .env.local (local dev) — real secrets live in coord/.env.local,
# symlinked as .env.local in each worktree. Never commit .env.local.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
APIFY_TOKEN=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional fallback if Gemini rate limits block the cohort run:
# GROQ_API_KEY=
